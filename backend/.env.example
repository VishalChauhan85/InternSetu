NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/internsetu
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (Vercel prod + local dev).
# Any *.vercel.app preview URL is always allowed automatically — no need to
# list preview URLs here.
CLIENT_URL=http://localhost:5173,https://internsetu.vercel.app

# Required to call POST /api/auth/seed-admin exactly once per environment.
# Set this to a long random string, call the route with header
# `x-seed-secret: <this value>`, then you may rotate/remove it.
ADMIN_SEED_SECRET=replace_this_with_a_long_random_secret_string

GEMINI_API_KEY=your_gemini_api_key_here
GROK_API_KEY=your_grok_api_key_here
